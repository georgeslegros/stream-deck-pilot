@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* Honours a path base (e.g. served under /deck behind a proxy) so relative URLs resolve. *@
    <base href="@($"{HttpContext?.Request.PathBase}/")" />
    <title>Stream Deck Pilot</title>
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["_content/StreamDeckPilot.Web/app.css"]" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    @* Reconnect banner (#108). Blazor finds it by id and sets components-reconnect-* classes on it
       while the circuit's connection is down; app.css shows the matching line. Live state needs no
       extra resync: a circuit that reconnects kept its subscription, and a rejected circuit (server
       restarted) makes Blazor reload the page, which starts from a fresh snapshot. *@
    <div id="components-reconnect-modal" class="sdp-reconnect" role="status" aria-live="polite" data-testid="reconnect-banner">
        <span class="sdp-reconnect-retrying">Connection lost. Reconnecting…</span>
        <span class="sdp-reconnect-failed">Can't reach the service. <a href="" class="sdp-reconnect-reload" onclick="location.reload(); return false;">Reload</a></span>
    </div>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <script src="@Assets["_content/StreamDeckPilot.Web/app.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    // The account pages (sign-in, setup, denied) are plain server-rendered forms: they set the
    // session cookie, which an interactive circuit can't. Everything else runs interactively.
    private IComponentRenderMode? PageRenderMode =>
        HttpContext?.AcceptsInteractiveRouting() == false ? null : InteractiveServer;
}
