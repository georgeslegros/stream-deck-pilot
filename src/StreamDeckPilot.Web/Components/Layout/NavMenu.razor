@* Add new pages here. Every page needs a viewer; pages that change anything need an admin (#97). *@
<MudNavMenu Class="sdp-nav" data-testid="nav-menu">
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Overview</MudNavLink>
    @if (Selection.Serial is { } serial)
    {
        <MudNavLink Href="@($"board/{Uri.EscapeDataString(serial)}")" Icon="@Icons.Material.Filled.GridView">Deck @serial</MudNavLink>
    }
</MudNavMenu>

@implements IDisposable
@inject DeviceSelection Selection

@code {
    protected override void OnInitialized() => Selection.Changed += OnSelectionChanged;

    private void OnSelectionChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Selection.Changed -= OnSelectionChanged;
}
