@implements IDisposable
@inject IDashboardSource Source
@inject ILogger<LiveBoard> Logger

@* The page on screen, key by key (#99), as the deck shows it. A KeyRendered event swaps only that
   key's image, when its content hash changed. A deck that isn't connected has no painted frames:
   its keys follow desired state, refreshed when that changes. Nothing polls. *@
<div class="sdp-board" style="--sdp-cols: @Columns" role="img"
     aria-label="@($"Keys of {Serial} on page {PageId ?? "none"}")" data-testid="live-board" data-serial="@Serial">
    @for (var i = 0; i < Columns * Rows; i++)
    {
        var key = i;
        if (_images.TryGetValue(key, out var image))
        {
            <img src="@image.DataUri" alt="" data-testid="board-key" data-key="@key" data-etag="@image.ETag" />
        }
        else
        {
            <span class="sdp-key-blank" data-testid="board-key" data-key="@key"></span>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public string Serial { get; set; } = "";
    [Parameter] public int Columns { get; set; } = 5;
    [Parameter] public int Rows { get; set; } = 3;
    [Parameter] public string? PageId { get; set; }

    private readonly Dictionary<int, InlineImage> _images = new();
    // Last content hash seen per key (from KeyRendered), so a repeated hash costs nothing.
    private readonly Dictionary<int, string> _hashes = new();
    private CoalescingRunner? _reload;
    private string? _loadedFor;

    protected override void OnInitialized()
    {
        _reload = new CoalescingRunner(() => InvokeAsync(ReloadAllAsync),
            ex => Logger.LogWarning(ex, "Could not refresh the key images of {Serial}", Serial));
        Source.EventApplied += OnEvent;
        Source.DesiredStateChanged += OnDesiredStateChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        var target = $"{Serial}|{PageId}";
        if (_loadedFor == target) return;
        _loadedFor = target;
        _hashes.Clear();
        await ReloadAllAsync();
    }

    private void OnEvent(LiveEvent e)
    {
        if (e.Serial != Serial) return;
        switch (e)
        {
            case KeyRendered k:
                _ = InvokeAsync(() => SwapKeyAsync(k));
                break;
            case DeviceConnected or DeviceDisconnected or ConfigChanged:
                _reload!.Request();
                break;
            // PageChanged arrives as a new PageId parameter from the parent.
        }
    }

    // A deck that isn't connected shows desired state; connected decks are covered by KeyRendered.
    private void OnDesiredStateChanged(string serial)
    {
        if (serial == Serial && Source.Snapshot?.Device(serial)?.IsConnected != true)
            _reload!.Request();
    }

    private async Task SwapKeyAsync(KeyRendered e)
    {
        if (_hashes.TryGetValue(e.Key, out var seen) && seen == e.Hash) return;
        _hashes[e.Key] = e.Hash;
        try
        {
            if (await Source.GetKeyImageAsync(Serial, e.Key) is not { } image) return;
            if (_images.TryGetValue(e.Key, out var shown) && shown.ETag == image.ETag) return;
            _images[e.Key] = image;
            StateHasChanged();
        }
        catch (Exception ex) { Logger.LogWarning(ex, "Could not refresh key {Key} of {Serial}", e.Key, Serial); }
    }

    private async Task ReloadAllAsync()
    {
        var changed = false;
        for (var key = 0; key < Columns * Rows; key++)
        {
            var image = await Source.GetKeyImageAsync(Serial, key);
            if (image is null)
                changed |= _images.Remove(key);
            else if (!_images.TryGetValue(key, out var shown) || shown.ETag != image.ETag)
            {
                _images[key] = image;
                changed = true;
            }
        }
        if (changed) StateHasChanged();
    }

    public void Dispose()
    {
        Source.EventApplied -= OnEvent;
        Source.DesiredStateChanged -= OnDesiredStateChanged;
    }
}
