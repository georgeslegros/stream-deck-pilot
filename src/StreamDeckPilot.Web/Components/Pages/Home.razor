@page "/"
@implements IDisposable
@inject IDashboardSource Source
@inject BrowserClock Clock
@inject ILogger<Home> Logger

<PageTitle>Overview · Stream Deck Pilot</PageTitle>

@* The read-only dashboard (#99). Everything on it is pushed (#108): nothing polls, and ages are
   as of the last update shown under the title. *@
<MudText Typo="Typo.h4" HtmlTag="h1" GutterBottom="true">Overview</MudText>

@if (_snapshot is null)
{
    <MudProgressCircular Indeterminate="true" aria-label="Loading" />
}
else
{
    <MudText Typo="Typo.caption" Class="d-block mb-3" data-testid="as-of">
        As of <time datetime="@Clock.Now.ToString("O")">@Clock.Time(Clock.Now)</time>; updates as they happen.
    </MudText>

    <MudGrid Spacing="2" Class="mb-4">
        <MudItem xs="12" md="6">
            <BrokerCard Broker="_snapshot.Broker" />
        </MudItem>
    </MudGrid>

    @if (_snapshot.Devices.Length == 0)
    {
        <MudAlert Severity="Severity.Info" data-testid="no-devices">
            No decks have been discovered yet. Plug one in; it appears here once the service has seen it.
        </MudAlert>
    }
    else
    {
        @foreach (var device in _snapshot.Devices)
        {
            <DeviceDashboard @key="device.Serial" Device="device" Snapshot="_snapshot" Brightness="_snapshot.Brightness" />
        }
    }
}

@code {
    private LiveSnapshot? _snapshot;
    private CoalescingRunner? _refresh;

    protected override async Task OnInitializedAsync()
    {
        _refresh = new CoalescingRunner(() => InvokeAsync(() =>
        {
            _snapshot = Source.Snapshot;
            StateHasChanged();
        }), ex => Logger.LogWarning(ex, "Could not refresh the overview"));
        Source.Changed += _refresh.Request;
        _snapshot = await Source.StartAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && await Clock.LoadAsync()) StateHasChanged();
    }

    public void Dispose()
    {
        if (_refresh is not null) Source.Changed -= _refresh.Request;
    }
}
