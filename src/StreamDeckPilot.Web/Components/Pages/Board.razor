@page "/board/{Serial}"
@implements IDisposable
@inject IDashboardSource Source
@inject DeviceSelection Selection
@inject BrowserClock Clock
@inject ILogger<Board> Logger

<PageTitle>@Serial · Stream Deck Pilot</PageTitle>

@* One deck's dashboard (#99): the same live view as the overview, for this deck only. *@
<MudText Typo="Typo.h4" HtmlTag="h1" GutterBottom="true" Class="sdp-break">Deck @Serial</MudText>

@if (_snapshot is null)
{
    <MudProgressCircular Indeterminate="true" aria-label="Loading" />
}
else if (_snapshot.Device(Serial) is not { } device)
{
    <MudAlert Severity="Severity.Warning" data-testid="unknown-device">This deck is not in the catalogue.</MudAlert>
}
else
{
    <MudText Typo="Typo.caption" Class="d-block mb-3" data-testid="as-of">
        As of <time datetime="@Clock.Now.ToString("O")">@Clock.Time(Clock.Now)</time>; updates as they happen.
    </MudText>
    <DeviceDashboard @key="device.Serial" Device="device" Snapshot="_snapshot" Brightness="_snapshot.Brightness" ShowLink="false" />
}

@code {
    [Parameter] public string Serial { get; set; } = "";

    private LiveSnapshot? _snapshot;
    private CoalescingRunner? _refresh;

    protected override void OnInitialized()
    {
        _refresh = new CoalescingRunner(() => InvokeAsync(() =>
        {
            _snapshot = Source.Snapshot;
            StateHasChanged();
        }), ex => Logger.LogWarning(ex, "Could not refresh deck {Serial}", Serial));
        Source.Changed += _refresh.Request;
    }

    protected override async Task OnParametersSetAsync()
    {
        Selection.Select(Serial);
        _snapshot = await Source.StartAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && await Clock.LoadAsync()) StateHasChanged();
    }

    public void Dispose()
    {
        if (_refresh is not null) Source.Changed -= _refresh.Request;
    }
}
